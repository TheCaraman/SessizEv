; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Quiet Hours"
config/version="0.1.13-dev.20261117.1"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
InputSetup="*res://scripts/core/input_setup.gd"
GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/save/save_manager.gd"
Settings="*res://scripts/core/settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.tr.translation")
locale/fallback="en"

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=3
